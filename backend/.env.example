# Server Configuration
PROJECT_NAME="MAILSENTINEL"
API_V1_STR="/api/v1"
PORT=8000
HOST="127.0.0.1"
ENVIRONMENT="development"
DEBUG=true

# Security & Session Configuration
SECRET_KEY="development_secret_key_change_in_production_mailsentinel_sih"
AUTH_SECRET_KEY="mailsentinel_production_auth_hmac_secret_key_2026"
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_MIN_LENGTH=8
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
REQUIRE_AUTH=true

# Rate Limiting & Throttling
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=120

# CORS & Cross-Origin Protection
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000"

# Feature Toggles
ALLOW_DEMO_BLOCKCHAIN=true
ALLOW_TAMPER_SIMULATION=true

# External AI Provider (Optional - offline fallback active by default)
OPENAI_API_KEY=""
AI_PROVIDER="fallback"

# Logging
LOG_LEVEL="INFO"

# Threat Intelligence Configuration
ABUSEIPDB_API_KEY=""
INTELLIGENCE_CACHE_TTL=21600
